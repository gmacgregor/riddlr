<Layouts.game flash={@flash} current_scope={@current_scope} theme={@theme}>
  <:status>
    <GameComponents.status_pill
      :if={@next && @next.play_status == "live"}
      kind={:home_live}
      href={~p"/game/#{@next.id}/play"}
    />
  </:status>
  <section class="rg-view" aria-labelledby="home-h">
    <div class="rg-wrap rg-home">
      <section class="rg-hero" aria-labelledby="home-h">
        <%!-- Nothing next: no card, just the news and a practice riddle. --%>
        <%= if @hero == :none do %>
          <div id="hero-tbd" class="rg-tbd">
            <div class="rg-tbd__intro">
              <p class="rg-tbd__eyebrow">{GameCopy.Home.tbd_eyebrow()}</p>
              <h1 id="home-h" class="rg-tbd__h" tabindex="-1" data-headline={@headline}>
                {@tbd_headline.text} <span>{@tbd_headline.tail}</span>
              </h1>
              <p class="rg-tbd__lede">{GameCopy.Home.tbd_lede()}</p>
            </div>
            <GameComponents.join_note current_scope={@current_scope} />
            <.practice_note practice={@practice} />
          </div>
        <% else %>
          <div class="rg-hero__head">
            <h1 id="home-h" class="rg-hero__eyebrow" tabindex="-1">
              <span class="rg-hl">{GameCopy.Home.hero_heading()}</span>
            </h1>
            <p id="hero-date" class="rg-hero__date">
              <GameComponents.Clock.drop_time
                id={"hero-date-#{@next.id}-#{DateTime.to_unix(@next.live_date)}"}
                at={@next.live_date}
                now={@today}
                format="long"
              />
            </p>
            <p class="rg-hero__aside" aria-hidden="true">
              {GameCopy.Home.hero_aside()}
              <svg class="rg-doodle" viewBox="0 0 72 56">
                <path d="M5 6 C26 0 56 10 62 40" /><path d="M50 33 L62 44 L68 27" />
              </svg>
            </p>
          </div>
          <%!-- While a riddle is open, the card is busy: the note sits above it. --%>
          <GameComponents.join_note
            :if={@hero in [:lobby, :live]}
            current_scope={@current_scope}
          />
          <div id="hero-sheet" class="rg-hero__sheet" data-state={@hero}>
            <Thinker.thinker id="hero-thinker" n={@thinker} />
            <div id="hero-card" class="rg-hero__card">
              <%= case @hero do %>
                <% :live -> %>
                  <div class="rg-hero__row">
                    <span class="rg-hero__label">{GameCopy.Home.hero_live(@next.category.name)}</span>
                    <span class="rg-pill rg-pill--live">
                      <span class="rg-live-dot" aria-hidden="true"></span>
                      <span id="hero-left">{GameCopy.m_ss(@seconds)}</span>&nbsp;{GameCopy.Home.hero_left()}
                    </span>
                  </div>
                  <p class="rg-hero__teaser">
                    {GameCopy.Home.hero_teaser_lead()}
                    <b>{GameCopy.Home.hero_teaser_count(@solved)}</b> {GameCopy.Home.hero_teaser_tail()}
                  </p>
                  <.link navigate={~p"/game/#{@next.id}/play"} class="rg-btn rg-btn--accent">
                    {GameCopy.Results.next_jump_in()} <GameComponents.icon name="arrow" />
                  </.link>
                <% :lobby -> %>
                  <.drop riddle={@next} seconds={@seconds} />
                  <p id="hero-count" class="rg-hero__meta">
                    {GameCopy.Home.hero_waiting(@waiting)}
                  </p>
                  <.link navigate={~p"/game/#{@next.id}/lobby"} class="rg-btn rg-btn--accent">
                    {GameCopy.Results.next_enter_lobby()} <GameComponents.icon name="arrow" />
                  </.link>
                <% :future -> %>
                  <.drop riddle={@next} seconds={@seconds} />
                  <GameComponents.join_note current_scope={@current_scope} />
                  <.practice_note practice={@practice} />
              <% end %>
            </div>
          </div>
        <% end %>
        <p id="hero-standings" class="rg-hero__standings">
          <GameComponents.trophy class="rg-hero__trophy" />
          <.link navigate={~p"/standings"} class="rg-link-btn">{GameCopy.standings_link()}</.link>
        </p>
      </section>

      <section id="timeline" class="rg-panel rg-intro" aria-labelledby="timeline-h">
        <h2 id="timeline-h" class="rg-panel__h">{GameCopy.Home.timeline_heading()}</h2>
        <ol id="timeline-reel" class="rg-reel" phx-hook=".Reel">
          <li
            :for={{step, row} <- Enum.with_index(GameCopy.Home.timeline_steps(@round_end))}
            class={["rg-reel__row", row == 2 && "rg-reel__row--time"]}
            style={"--row: #{row}"}
          >
            <span class="rg-reel__t">{step.time}</span>
            <div class="rg-reel__body">
              <h3 class="rg-reel__h">{step.title}</h3>
              <p class="rg-reel__s">{step.text}</p>
              <p class="rg-reel__note">{step.note}</p>
            </div>
            <svg
              :if={row == 2}
              class="rg-doodle rg-doodle--watch"
              viewBox="0 0 64 72"
              aria-hidden="true"
            >
              <path d="M10 42 C10 29 20 20 32 20 C45 20 54 30 54 42 C54 55 44 64 32 64 C19 64 10 54 10 42 Z" />
              <path d="M26 11 H38" /><path d="M32 11 V20" /><path d="M49 24 L54 19" />
              <path d="M32 42 V31" /><path d="M32 42 L40 47" />
            </svg>
            <%!-- The .Reel hook draws the arrow to the step's size. --%>
            <span
              :if={row < 2}
              id={"reel-arrow-#{row}"}
              class="rg-reel__arrow"
              aria-hidden="true"
              phx-update="ignore"
            >
              <svg><path /></svg>
            </span>
          </li>
        </ol>
        <script :type={Phoenix.LiveView.ColocatedHook} name=".Reel">
          // Flips the timeline in once it scrolls into view. Both classes go on
          // through JS commands, so LiveView patches keep them. Without
          // IntersectionObserver the timeline shows at once. It also draws
          // each step's arrow to the step's size, again when the page resizes.
          import {reelArrowPath} from "@/js/reel_arrow"

          export default {
            mounted() {
              this.drawArrows()
              if ("ResizeObserver" in window) {
                this.resizer = new ResizeObserver(() => this.drawArrows())
                this.resizer.observe(this.el)
              }
              if (!("IntersectionObserver" in window)) {
                this.js().addClass(this.el, "is-flipped")
                return
              }
              this.js().addClass(this.el, "is-armed")
              this.observer = new IntersectionObserver((entries) => {
                if (entries.some((e) => e.isIntersecting)) {
                  this.js().addClass(this.el, "is-flipped")
                  this.observer.disconnect()
                }
              }, { threshold: 0.35 })
              this.observer.observe(this.el)
            },
            drawArrows() {
              this.el.querySelectorAll(".rg-reel__arrow svg").forEach((svg) => {
                const {width, height} = svg.getBoundingClientRect()
                svg.setAttribute("viewBox", `0 0 ${width} ${height}`)
                svg.firstElementChild.setAttribute("d", reelArrowPath(width, height))
              })
            },
            destroyed() {
              this.observer && this.observer.disconnect()
              this.resizer && this.resizer.disconnect()
            }
          }
        </script>
      </section>

      <section id="schedule" class="rg-panel rg-schedule" aria-labelledby="sched-h">
        <h2 id="sched-h" class="rg-panel__h">{GameCopy.Home.schedule_heading()}</h2>
        <p :if={@upcoming == []} class="rg-schedule__empty">{GameCopy.Home.schedule_empty()}</p>
        <ol :if={@upcoming != []} class="rg-schedule__list">
          <li :for={riddle <- @upcoming} id={"sched-#{riddle.id}"} class="rg-sched">
            <span class="rg-sched__body">
              <span class="rg-sched__sub">
                <GameComponents.Clock.drop_time
                  id={"sched-at-#{riddle.id}-#{DateTime.to_unix(riddle.live_date)}"}
                  at={riddle.live_date}
                  now={@today}
                  local={false}
                /> · {riddle.category.name}
                <GameComponents.Clock.drop_local
                  id={"sched-local-#{riddle.id}-#{DateTime.to_unix(riddle.live_date)}"}
                  at={riddle.live_date}
                />
              </span>
              <span class="rg-sched__cat">{GameCopy.riddle_name(riddle)}</span>
            </span>
            <span class="rg-sched__solve">
              <GameComponents.icon name="clock" /> {GameComponents.Clock.clock_str(
                riddle.solve_time
              )}
            </span>
          </li>
        </ol>
      </section>

      <section id="last" class="rg-panel rg-last" aria-labelledby="last-h">
        <h2 id="last-h" class="rg-panel__h">{GameCopy.Home.last_heading()}</h2>
        <div :if={!@last} class="rg-last__empty">
          <span class="rg-last__empty-t">{GameCopy.Home.last_empty_title()}</span>
          <span class="rg-last__empty-s">{GameCopy.Home.last_empty_text()}</span>
        </div>
        <div :if={@last} class="rg-lastcard">
          <p class="rg-lastcard__q">“{@last.description}”</p>
          <div class="rg-lastcard__a">
            <span class="rg-lastcard__answer" data-tone={@last_tone}><span>{@last_answer}</span></span>
            <span class="rg-lastcard__win">
              <%= if @last_win do %>
                {GameCopy.Results.results_by_lead()} <b>{@last_win.name}</b>
                in <span class="rg-nowrap">{@last_win.secs}</span>
              <% else %>
                {GameCopy.Home.last_unsolved()}
              <% end %>
            </span>
          </div>
          <.link navigate={~p"/game/#{@last.id}/results"} class="rg-link-btn">
            {GameCopy.Home.last_link()}
          </.link>
        </div>
        <.link navigate={~p"/standings"} class="rg-link-btn rg-last__standings">
          {GameCopy.standings_link()}
        </.link>
      </section>
    </div>
  </section>
</Layouts.game>
