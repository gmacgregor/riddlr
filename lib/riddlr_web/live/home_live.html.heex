<Layouts.game flash={@flash} current_scope={@current_scope} theme={@theme}>
  <canvas
    id="home-leaves"
    class="rg-leaves"
    phx-hook=".Leaves"
    phx-update="ignore"
    aria-hidden="true"
  ></canvas>
  <script :type={Phoenix.LiveView.ColocatedHook} name=".Leaves">
    // Leaves fall from the top of the page once, as it loads, and pile up at
    // the bottom, behind everything. The physics lives in leaves.js; this
    // draws each leaf as a doodle (a felt-pen fill set off its ink outline)
    // and feeds in the pointer, so a moving mouse or finger knocks along any
    // leaf it touches, falling or in the pile.
    //
    // It runs light. Frames run only while a leaf moves: once the pile is
    // still, the loop stops, and only a pointer touching a leaf starts it
    // again. The canvas is at most 1.5 times the page's pixel size. Under
    // reduced motion the pile is drawn once, still, and the pointer is not
    // watched.
    import {createField, isStill, leafPaths, resize, settle, step, touchesAny} from "@/js/leaves"

    const COUNT = 40
    const TONES = ["--tone-3", "--tone-4", "--doodle-fill", "--success"]
    // Past this, more pixels per CSS pixel cost memory and barely sharpen
    // leaves this small.
    const MAX_DPR = 1.5
    // A pointer that has not moved for this long counts as still.
    const STILL_MS = 80
    // Leaves settle well inside this; past it, the loop stops whatever, so a
    // bug can't leave it running.
    const MAX_AWAKE_MS = 90000

    export default {
      mounted() {
        this.ctx = this.el.getContext("2d")
        this.reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches
        this.readColours()
        this.fit()
        this.field = createField({width: this.w, height: this.h, count: COUNT})

        // Resizes come in bursts; fit once a frame at most.
        this.onResize = () => {
          if (this.sizing) return
          this.sizing = requestAnimationFrame(() => {
            this.sizing = null
            this.fit()
            resize(this.field, this.w, this.h)
            if (this.reduced) settle(this.field)
            this.draw()
            this.wake()
          })
        }
        window.addEventListener("resize", this.onResize)

        if (this.reduced) {
          settle(this.field)
          this.draw()
        } else {
          this.onPointer = (e) => {
            const p = e.touches ? e.touches[0] : e
            if (p) this.track(p.clientX, p.clientY)
          }
          window.addEventListener("pointermove", this.onPointer, {passive: true})
          window.addEventListener("touchmove", this.onPointer, {passive: true})
          this.wake()
        }

        // The colour mode switch flips data-theme on <html>.
        this.themer = new MutationObserver(() => {
          this.readColours()
          this.draw()
        })
        this.themer.observe(document.documentElement, {attributeFilter: ["data-theme"]})
      },

      destroyed() {
        cancelAnimationFrame(this.frame)
        cancelAnimationFrame(this.sizing)
        window.removeEventListener("resize", this.onResize)
        if (this.onPointer) {
          window.removeEventListener("pointermove", this.onPointer)
          window.removeEventListener("touchmove", this.onPointer)
        }
        this.themer.disconnect()
        this.field = null
      },

      // Sizes the canvas to the viewport, sharp on high-density screens. It
      // only takes new pixels when the size has changed.
      fit() {
        const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR)
        this.w = window.innerWidth
        this.h = window.innerHeight
        const width = Math.round(this.w * dpr)
        const height = Math.round(this.h * dpr)
        if (this.el.width !== width || this.el.height !== height) {
          this.el.width = width
          this.el.height = height
        }
        this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      },

      // Reads the theme tokens as colours the canvas takes, through a probe.
      // The probe sits on <body>, outside .rg-app, whose reduced-motion rule
      // gives every element a short transition: inside, the probe would
      // still show its old colour when read.
      readColours() {
        const probe = document.createElement("i")
        probe.style.cssText = "position:absolute;visibility:hidden"
        document.body.append(probe)
        const get = (name) => {
          probe.style.color = `var(${name})`
          return getComputedStyle(probe).color
        }
        this.ink = get("--leaf-ink")
        this.tones = TONES.map(get)
        probe.remove()
      },

      // Works out the pointer's speed from its last move. A sleeping loop
      // wakes only when the pointer touches a leaf.
      track(x, y) {
        const now = performance.now()
        const last = this.pointer
        const dt = last ? (now - last.t) / 1000 : 0
        if (last && dt < 0.004) return
        const vx = dt > 0 && dt < 0.1 ? (x - last.x) / dt : 0
        const vy = dt > 0 && dt < 0.1 ? (y - last.y) / dt : 0
        this.pointer = {
          x, y, t: now,
          px: last ? last.x : x,
          py: last ? last.y : y,
          vx: last ? (last.vx + vx) / 2 : 0,
          vy: last ? (last.vy + vy) / 2 : 0,
        }
        if (!this.frame && touchesAny(this.field, this.pointer)) this.wake()
      },

      wake() {
        if (this.reduced || this.frame) return
        this.last = this.woke = performance.now()
        this.frame = requestAnimationFrame((t) => this.tick(t))
      },

      tick(now) {
        const dt = Math.min(0.05, (now - this.last) / 1000)
        this.last = now
        const p = this.pointer
        step(this.field, dt, p && now - p.t < STILL_MS ? p : null)
        this.draw()
        const done = isStill(this.field) || now - this.woke > MAX_AWAKE_MS
        this.frame = done ? null : requestAnimationFrame((t) => this.tick(t))
      },

      draw() {
        const ctx = this.ctx
        ctx.clearRect(0, 0, this.w, this.h)
        ctx.lineCap = "round"
        ctx.lineJoin = "round"
        ctx.strokeStyle = this.ink
        for (const leaf of this.field.leaves) {
          if (leaf.y < -leaf.size) continue
          leaf.paths ||= this.paths(leaf)
          ctx.save()
          ctx.translate(leaf.x, leaf.y)
          ctx.rotate(leaf.rot)
          ctx.scale(1, leaf.face)
          ctx.fillStyle = this.tones[leaf.tone % this.tones.length]
          ctx.translate(1.5, 1.2)
          ctx.fill(leaf.paths.outline)
          ctx.translate(-1.5, -1.2)
          ctx.lineWidth = 1.5
          ctx.stroke(leaf.paths.outline)
          ctx.lineWidth = 1.1
          ctx.stroke(leaf.paths.veins)
          ctx.restore()
        }
      },

      paths(leaf) {
        const {outline, veins} = leafPaths(leaf.shape, leaf.size)
        return {outline: new Path2D(outline), veins: new Path2D(veins)}
      },
    }
  </script>
  <section class="rg-view" aria-labelledby="home-h">
    <div class="rg-wrap rg-home">
      <section class="rg-hero" aria-labelledby="home-h">
        <%!-- Nothing next: no card, just the news and a practice riddle. --%>
        <%= if @hero == :none do %>
          <div id="hero-tbd" class="rg-tbd">
            <div class="rg-tbd__intro">
              <p class="rg-tbd__eyebrow">{GameCopy.Home.tbd_eyebrow()}</p>
              <h1 id="home-h" class="rg-tbd__h" tabindex="-1" data-headline={@headline}>
                {@tbd_headline.text} <span>{@tbd_headline.tail}</span>
              </h1>
              <p class="rg-tbd__lede">{GameCopy.Home.tbd_lede()}</p>
            </div>
            <GameComponents.join_note current_scope={@current_scope} />
            <.practice_note practice={@practice} />
          </div>
        <% else %>
          <div class="rg-hero__head">
            <h1 id="home-h" class="rg-hero__eyebrow" tabindex="-1">
              <span class="rg-hl">{GameCopy.Home.hero_heading()}</span>
            </h1>
            <p id="hero-date" class="rg-hero__date">
              <GameComponents.Clock.drop_time
                id={"hero-date-#{@next.id}-#{DateTime.to_unix(@next.live_date)}"}
                at={@next.live_date}
                now={@today}
                format="long"
              />
            </p>
            <p class="rg-hero__aside" aria-hidden="true">
              {GameCopy.Home.hero_aside()}
              <svg class="rg-doodle" viewBox="0 0 72 56">
                <path d="M5 6 C26 0 56 10 62 40" /><path d="M50 33 L62 44 L68 27" />
              </svg>
            </p>
          </div>
          <%!-- While a riddle is open, the card is busy: the note sits above it. --%>
          <GameComponents.join_note
            :if={@hero in [:lobby, :live]}
            current_scope={@current_scope}
          />
          <div id="hero-sheet" class="rg-hero__sheet" data-state={@hero}>
            <Thinker.thinker id="hero-thinker" n={@thinker} />
            <div id="hero-card" class="rg-hero__card">
              <%= case @hero do %>
                <% :live -> %>
                  <div class="rg-hero__row">
                    <span class="rg-hero__label">{GameCopy.Home.hero_live(@next.category.name)}</span>
                    <span class="rg-pill rg-pill--live">
                      <span class="rg-live-dot" aria-hidden="true"></span>
                      <span id="hero-left">{GameCopy.m_ss(@seconds)}</span>&nbsp;{GameCopy.Home.hero_left()}
                    </span>
                  </div>
                  <p class="rg-hero__teaser">
                    {GameCopy.Home.hero_teaser_lead()}
                    <b>{GameCopy.Home.hero_teaser_count(@solved)}</b> {GameCopy.Home.hero_teaser_tail()}
                  </p>
                  <.link navigate={~p"/game/#{@next.id}/play"} class="rg-btn rg-btn--accent">
                    {GameCopy.Results.next_jump_in()} <GameComponents.icon name="arrow" />
                  </.link>
                <% :lobby -> %>
                  <.drop riddle={@next} seconds={@seconds} />
                  <p id="hero-count" class="rg-hero__meta">
                    {GameCopy.Home.hero_waiting(@waiting)}
                  </p>
                  <.link navigate={~p"/game/#{@next.id}/lobby"} class="rg-btn rg-btn--accent">
                    {GameCopy.Results.next_enter_lobby()} <GameComponents.icon name="arrow" />
                  </.link>
                <% :future -> %>
                  <.drop riddle={@next} seconds={@seconds} />
                  <GameComponents.join_note current_scope={@current_scope} />
                  <.practice_note practice={@practice} />
              <% end %>
            </div>
          </div>
        <% end %>
        <GameComponents.standings_note id="hero-standings" />
      </section>

      <section id="timeline" class="rg-panel rg-intro" aria-labelledby="timeline-h">
        <h2 id="timeline-h" class="rg-panel__h">{GameCopy.Home.timeline_heading()}</h2>
        <ol id="timeline-reel" class="rg-reel" phx-hook=".Reel">
          <li
            :for={{step, row} <- Enum.with_index(GameCopy.Home.timeline_steps(@round_end))}
            class={["rg-reel__row", row == 2 && "rg-reel__row--time"]}
            style={"--row: #{row}"}
          >
            <span class="rg-reel__t">{step.time}</span>
            <div class="rg-reel__body">
              <h3 class="rg-reel__h">{step.title}</h3>
              <p class="rg-reel__s">{step.text}</p>
              <p class="rg-reel__note">{step.note}</p>
            </div>
            <svg
              :if={row == 2}
              class="rg-doodle rg-doodle--watch"
              viewBox="0 0 64 72"
              aria-hidden="true"
            >
              <path d="M10 42 C10 29 20 20 32 20 C45 20 54 30 54 42 C54 55 44 64 32 64 C19 64 10 54 10 42 Z" />
              <path d="M26 11 H38" /><path d="M32 11 V20" /><path d="M49 24 L54 19" />
              <path d="M32 42 V31" /><path d="M32 42 L40 47" />
            </svg>
            <%!-- The .Reel hook draws the arrow to the step's size. --%>
            <span
              :if={row < 2}
              id={"reel-arrow-#{row}"}
              class="rg-reel__arrow"
              aria-hidden="true"
              phx-update="ignore"
            >
              <svg><path /></svg>
            </span>
          </li>
        </ol>
        <script :type={Phoenix.LiveView.ColocatedHook} name=".Reel">
          // Flips the timeline in once it scrolls into view. Both classes go on
          // through JS commands, so LiveView patches keep them. Without
          // IntersectionObserver the timeline shows at once. It also draws
          // each step's arrow to the step's size, again when the page resizes.
          import {reelArrowPath} from "@/js/reel_arrow"

          export default {
            mounted() {
              this.drawArrows()
              if ("ResizeObserver" in window) {
                this.resizer = new ResizeObserver(() => this.drawArrows())
                this.resizer.observe(this.el)
              }
              if (!("IntersectionObserver" in window)) {
                this.js().addClass(this.el, "is-flipped")
                return
              }
              this.js().addClass(this.el, "is-armed")
              this.observer = new IntersectionObserver((entries) => {
                if (entries.some((e) => e.isIntersecting)) {
                  this.js().addClass(this.el, "is-flipped")
                  this.observer.disconnect()
                }
              }, { threshold: 0.35 })
              this.observer.observe(this.el)
            },
            drawArrows() {
              this.el.querySelectorAll(".rg-reel__arrow svg").forEach((svg) => {
                const {width, height} = svg.getBoundingClientRect()
                svg.setAttribute("viewBox", `0 0 ${width} ${height}`)
                svg.firstElementChild.setAttribute("d", reelArrowPath(width, height))
              })
            },
            destroyed() {
              this.observer && this.observer.disconnect()
              this.resizer && this.resizer.disconnect()
            }
          }
        </script>
      </section>

      <section id="schedule" class="rg-panel rg-schedule" aria-labelledby="sched-h">
        <h2 id="sched-h" class="rg-panel__h">{GameCopy.Home.schedule_heading()}</h2>
        <p :if={@upcoming == []} class="rg-schedule__empty">{GameCopy.Home.schedule_empty()}</p>
        <ol :if={@upcoming != []} class="rg-schedule__list">
          <li :for={riddle <- @upcoming} id={"sched-#{riddle.id}"} class="rg-sched">
            <span class="rg-sched__body">
              <span class="rg-sched__sub">
                <GameComponents.Clock.drop_time
                  id={"sched-at-#{riddle.id}-#{DateTime.to_unix(riddle.live_date)}"}
                  at={riddle.live_date}
                  now={@today}
                  local={false}
                /> · {riddle.category.name}
                <GameComponents.Clock.drop_local
                  id={"sched-local-#{riddle.id}-#{DateTime.to_unix(riddle.live_date)}"}
                  at={riddle.live_date}
                />
              </span>
              <span class="rg-sched__cat">{GameCopy.riddle_name(riddle)}</span>
            </span>
            <span class="rg-sched__solve">
              <GameComponents.icon name="clock" /> {GameComponents.Clock.clock_str(
                riddle.solve_time
              )} · {riddle.difficulty}
            </span>
          </li>
        </ol>
      </section>

      <section id="last" class="rg-panel rg-last" aria-labelledby="last-h">
        <h2 id="last-h" class="rg-panel__h">{GameCopy.Home.last_heading()}</h2>
        <div :if={!@last} class="rg-last__empty">
          <span class="rg-last__empty-t">{GameCopy.Home.last_empty_title()}</span>
          <span class="rg-last__empty-s">{GameCopy.Home.last_empty_text()}</span>
        </div>
        <div :if={@last} class="rg-lastcard">
          <p class="rg-lastcard__q">“{@last.description}”</p>
          <div class="rg-lastcard__a">
            <span class="rg-lastcard__answer" data-tone={@last_tone}><span>{@last_answer}</span></span>
            <span class="rg-lastcard__win">
              <%= if @last_win do %>
                {GameCopy.Results.results_by_lead()} <b>{@last_win.name}</b>
                in <span class="rg-nowrap">{@last_win.secs}</span>
              <% else %>
                {GameCopy.Home.last_unsolved()}
              <% end %>
            </span>
          </div>
          <.link navigate={~p"/game/#{@last.id}/results"} class="rg-link-btn">
            {GameCopy.Home.last_link()}
          </.link>
        </div>
      </section>

      <GameComponents.standings_note id="home-standings" />
    </div>
  </section>
</Layouts.game>
