<Layouts.game flash={@flash} current_scope={@current_scope}>
  <section class="rg-view" aria-labelledby="lobby-h">
    <div class="rg-wrap rg-lobby">
      <div class="rg-lobby__clock">
        <GameComponents.kicker number={@riddle.number} category={@riddle.category.name} />
        <h1 id="lobby-h" class="rg-lobby__h" tabindex="-1">{GameCopy.lobby_heading()}</h1>
        <GameComponents.flaps id="lobby-flaps" seconds={@time_remaining} />
        <p :if={@riddle.live_date} class="rg-lobby__when">
          {GameCopy.lobby_when_lead()} <b><GameComponents.local_time
              id="lobby-drop-time"
              at={@riddle.live_date}
            /></b>. {GameCopy.lobby_when_tail()}
        </p>
        <ul class="rg-facts">
          <li class="rg-fact">
            <GameComponents.icon name="clock" /> {GameCopy.solve_time(
              GameComponents.clock_str(@riddle.solve_time)
            )}
          </li>
          <li class="rg-fact"><GameComponents.icon name="trophy" /> {GameCopy.scoring_rule()}</li>
        </ul>
        <p id="lobby-ready" class="rg-lobby__ready" aria-live="assertive">
          {if @time_remaining in 1..5, do: GameCopy.lobby_ready()}
        </p>
      </div>

      <section class="rg-panel" aria-labelledby="room-h">
        <div class="rg-panel__head">
          <h2 id="room-h" class="rg-panel__h">In the room</h2>
          <span id="lobby-player-count" class="rg-count rg-nowrap" aria-live="polite">
            {GameCopy.players_waiting(@player_count)}
          </span>
        </div>
      </section>
    </div>
  </section>
</Layouts.game>
