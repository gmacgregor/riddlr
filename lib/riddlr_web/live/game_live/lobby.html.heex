<Layouts.game flash={@flash} current_scope={@current_scope} theme={@theme}>
  <:status>
    <GameComponents.status_pill kind={:lobby} number={@riddle.number} seconds={@time_remaining} />
  </:status>
  <section class="rg-view" aria-labelledby="lobby-h">
    <div class="rg-wrap rg-lobby">
      <div class="rg-lobby__clock">
        <GameComponents.kicker
          number={@riddle.number}
          name={@riddle.name}
          category={@riddle.category.name}
        />
        <h1 id="lobby-h" class="rg-lobby__h" tabindex="-1">{GameCopy.Lobby.lobby_heading()}</h1>
        <GameComponents.flaps id="lobby-flaps" seconds={@time_remaining} />
        <p :if={@riddle.live_date} class="rg-lobby__when">
          {GameCopy.Lobby.lobby_when_lead()}
          <b><GameComponents.drop_time
            id="lobby-drop-time"
            at={@riddle.live_date}
            local={false}
            mid_sentence
          /></b>
          <GameComponents.drop_local id="lobby-drop-local" at={@riddle.live_date} /><br />
          {if GameCopy.Lobby.lobby_when_tail() != "", do: GameCopy.Lobby.lobby_when_tail()}
        </p>
        <ul class="rg-facts">
          <li class="rg-fact">
            <GameComponents.icon name="clock" /> {GameCopy.Lobby.solve_time(
              GameComponents.clock_str(@riddle.solve_time)
            )}
          </li>
        </ul>
        <%!-- A guest cannot guess, so is not told to get ready. --%>
        <p :if={@current_scope} id="lobby-ready" class="rg-lobby__ready" aria-live="assertive">
          {if @time_remaining in 1..5, do: GameCopy.Lobby.lobby_ready()}
        </p>
        <GameComponents.join_note current_scope={@current_scope} />
      </div>

      <section class="rg-panel rg-room" aria-labelledby="room-h">
        <div class="rg-panel__head">
          <h2 id="room-h" class="rg-panel__h">{GameCopy.Lobby.room_heading()}</h2>
          <span id="room-count" class="rg-count rg-nowrap" aria-live="polite">
            {GameCopy.Lobby.room_count(length(@players))}
          </span>
        </div>
        <ul id="room-grid" class="rg-room__grid" phx-hook=".RoomGrid">
          <li
            :for={player <- @room.visible}
            id={"room-p-#{player.id}"}
            class={["rg-room__p", player.me? && "is-me"]}
          >
            <GameComponents.tile
              initial={GameComponents.initial(player.username)}
              tone={
                GameComponents.tone(
                  player.username,
                  @current_scope && @current_scope.user.username
                )
              }
            />
            <span class="rg-room__name">
              {if player.me?, do: GameCopy.Lobby.room_you(), else: player.username}
            </span>
          </li>
          <li :if={@room.more > 0} class="rg-room__more">
            <span class="rg-nowrap">{GameCopy.Lobby.room_more(@room.more)}</span>
          </li>
          <li :for={_ <- 1..@room.pad//1} class="rg-room__p rg-room__empty" aria-hidden="true">
            <span class="rg-tile">?</span><span class="rg-room__name">&nbsp;</span>
          </li>
        </ul>
        <p id="room-ticker" class="rg-ticker" aria-live="off">
          <span :if={@last_join} class="rg-ticker__dot" aria-hidden="true"></span>
          <span
            :if={@last_join}
            id={"room-ticker-#{@last_join.seq}"}
            class="rg-ticker__text"
          ><b>{@last_join.first}</b>{GameCopy.Lobby.ticker_tail(@last_join.others)}</span>
        </p>
      </section>

      <section class="rg-panel" aria-labelledby="rules-h">
        <h2 id="rules-h" class="rg-panel__h">{GameCopy.Lobby.rules_heading()}</h2>
        <ul class="rg-rules">
          <li :for={rule <- GameCopy.Lobby.rules()}>{rule}</li>
        </ul>
      </section>
    </div>
  </section>
  <script :type={Phoenix.LiveView.ColocatedHook} name=".RoomGrid">
    // Tells the server how many columns the room grid has at this width, so
    // it can fill exactly three rows. Sends only when the count changes.
    export default {
      mounted() {
        this.onResize = () => {
          cancelAnimationFrame(this.frame)
          this.frame = requestAnimationFrame(() => this.report())
        }
        window.addEventListener("resize", this.onResize)
        this.report()
      },
      destroyed() {
        window.removeEventListener("resize", this.onResize)
        cancelAnimationFrame(this.frame)
      },
      report() {
        const cols = getComputedStyle(this.el).gridTemplateColumns.split(" ").filter(Boolean).length
        if (cols > 0 && cols !== this.cols) {
          this.cols = cols
          this.pushEvent("room-cols", { cols })
        }
      }
    }
  </script>
</Layouts.game>
