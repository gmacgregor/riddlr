<%!-- ═══════════════════════════════════════════════════════════════
     TIMER SECTION — pre-game countdown
     ═══════════════════════════════════════════════════════════════ --%>
<section class="rg-timer-section" aria-label="Countdown to game start">
  <.game_countdown riddle={@riddle} time_remaining={@time_remaining} format={:long} />

  <div class="rg-pre-game__waiting" aria-live="polite" aria-atomic="true">
    <span class="rg-pre-game__label">
      {@player_count} {if @player_count == 1, do: "player waiting", else: "players waiting"}
    </span>
  </div>
</section>

<%!-- ═══════════════════════════════════════════════════════════════
     NAV BAR
     ═══════════════════════════════════════════════════════════════ --%>
<.game_nav active={:riddle} game_id={to_string(@riddle.id)} />

<%!-- ═══════════════════════════════════════════════════════════════
     JS HOOKS
     ═══════════════════════════════════════════════════════════════ --%>
<script :type={Phoenix.LiveView.ColocatedHook} name=".Countdown">
  export default {
    mounted() {
      this.tick()
      this.interval = setInterval(() => this.tick(), 1000)
      this.handleEvent("countdown-tick", ({ seconds }) => {
        this.el.dataset.seconds = seconds
        this.tick()
      })
    },
    destroyed() {
      clearInterval(this.interval)
    },
    tick() {
      const secs = parseInt(this.el.dataset.seconds, 10) || 0
      const formatMode = this.el.dataset.format || "long"

      // Mirror format_countdown/1 in custom_components.ex — edit there to change format.
      const days = Math.floor(secs / 86400)
      const rem1 = secs % 86400
      const h = Math.floor(rem1 / 3600).toString().padStart(2, "0")
      const m = Math.floor((rem1 % 3600) / 60).toString().padStart(2, "0")
      const s = (rem1 % 60).toString().padStart(2, "0")
      const hms = `${h}:${m}:${s}`

      if (formatMode === "short") {
        const totalHours = Math.floor(secs / 3600).toString().padStart(2, "0")
        const shortMinutes = Math.floor((secs % 3600) / 60).toString().padStart(2, "0")
        const shortSeconds = (secs % 60).toString().padStart(2, "0")
        this.el.textContent = `${totalHours}:${shortMinutes}:${shortSeconds}`
      } else {
        this.el.textContent = days > 0 ? `${days} ${days === 1 ? "day" : "days"}, ${hms}` : hms
      }

      if (secs <= 10) {
        this.el.style.color = "var(--error)"
      } else if (secs <= 60) {
        this.el.style.color = "var(--text-emphasis)"
      } else {
        this.el.style.color = "var(--accent-gold)"
      }

      this.el.classList.remove("countdown-tick")
      void this.el.offsetWidth
      this.el.classList.add("countdown-tick")
    }
  }
</script>
