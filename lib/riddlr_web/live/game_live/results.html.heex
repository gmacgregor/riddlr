<Layouts.game flash={@flash} current_scope={@current_scope}>
  <:status><GameComponents.status_pill kind={:results} number={@riddle.number} /></:status>
  <div id="results" class="rg-wrap rg-results rg-view" phx-hook=".ResultsTabs">
    <div class="rg-results__top">
      <GameComponents.kicker number={@riddle.number} category={@riddle.category.name} />
      <p class="rg-results__riddle">“{@riddle.description}”</p>
      <h1
        id="res-h"
        class={["rg-answer", @board == [] && "is-unsolved"]}
        tabindex="-1"
        aria-label={"Answer: #{@answer}"}
      >
        <%= for {char, i} <- Enum.with_index(String.graphemes(@answer)) do %>
          <span :if={char == " "} class="rg-answer__gap" aria-hidden="true"></span>
          <span
            :if={char != " "}
            class="rg-answer__l"
            style={"animation-delay: #{i * 40}ms"}
            aria-hidden="true"
          >{char}</span>
        <% end %>
      </h1>
      <p id="res-by" class="rg-results__by">
        <%= if first = List.first(@board) do %>
          {GameCopy.results_by_lead()} <b>{first.shown_as}</b>
          in <span class="rg-nowrap">{first.secs}</span>
          · {GameCopy.solved_count(length(@board))}
        <% else %>
          {GameCopy.results_unsolved()}
        <% end %>
      </p>
      <div id="res-you" class="rg-you">
        <span class={["rg-stamp", @you.none? && "is-none"]}>{@you.stamp}</span>
        <span class="rg-you__text">
          <span class="rg-you__t">{@you.title}</span>
          <span class="rg-you__s">{@you.sub}</span>
        </span>
      </div>
    </div>
    <%!-- The hook owns the tab state, so server patches must leave it alone. --%>
    <div id="results-tabs" class="rg-tabs" role="tablist" aria-label="Results" phx-update="ignore">
      <button
        id="tab-board"
        type="button"
        role="tab"
        class="rg-tab"
        aria-controls="panel-board"
        aria-selected="true"
      >
        Leaderboard
      </button>
      <button
        id="tab-chat"
        type="button"
        role="tab"
        class="rg-tab"
        aria-controls="panel-chat"
        aria-selected="false"
        tabindex="-1"
      >
        Chat <span id="chat-badge" class="rg-tab__badge" hidden></span>
      </button>
    </div>

    <section
      id="panel-board"
      class="rg-results__board"
      role="tabpanel"
      aria-labelledby="tab-board"
    >
      <h2 class="rg-panel__h rg-desk-only">Leaderboard</h2>
      <div class="rg-podium">
        <%= for place <- [2, 1, 3] do %>
          <% solver = Enum.at(@board, place - 1) %>
          <div :if={solver} class={"rg-pod rg-pod--#{place}"}>
            <div class="rg-pod__who">
              <GameComponents.tile
                initial={GameComponents.initial(solver.username)}
                tone={GameComponents.tone(solver.username, @current_user.username)}
                size="lg"
              />
              <span class="rg-pod__name">{solver.shown_as}</span>
              <span class="rg-pod__t">{solver.secs}</span>
            </div>
            <div class="rg-pod__block">
              <span class="rg-pod__place">{place}</span>
              <span class="rg-pod__pts">+{solver.points}</span>
            </div>
          </div>
          <div :if={!solver} class={"rg-pod rg-pod--#{place} rg-pod--empty"}>
            <div class="rg-pod__who">
              <span class="rg-tile rg-tile--lg rg-tile--open" aria-hidden="true">?</span>
              <span class="rg-pod__name">{GameCopy.podium_open()}</span>
              <span class="rg-pod__t">&nbsp;</span>
            </div>
            <div class="rg-pod__block">
              <span class="rg-pod__place">{place}</span>
            </div>
          </div>
        <% end %>
      </div>
      <ol class="rg-board">
        <li
          :for={solver <- @board}
          class={["rg-row", solver.me? && "is-me"]}
        >
          <span class="rg-row__place">{solver.placement}</span>
          <GameComponents.tile
            initial={GameComponents.initial(solver.username)}
            tone={GameComponents.tone(solver.username, @current_user.username)}
            size="sm"
          />
          <span class="rg-row__name">{solver.shown_as}</span>
          <span class="rg-row__t">{solver.secs}</span>
          <span class="rg-row__pts">+{solver.points}</span>
        </li>
        <li :if={@board == []} class="rg-board__empty">{GameCopy.board_empty()}</li>
      </ol>
      <section class="rg-payout" aria-labelledby="payout-h">
        <h3 id="payout-h" class="rg-panel__h">{GameCopy.payout_heading()}</h3>
        <ol class="rg-points__row">
          <li
            :for={cell <- @payout}
            class={[
              "rg-pt",
              if(cell.solver, do: "is-taken", else: "is-open"),
              cell.solver && cell.solver.me? && "is-me"
            ]}
          >
            <span class="rg-pt__p">{GameCopy.ordinal(cell.place)}</span>
            <span class="rg-pt__v">{cell.points}</span>
            <span class="rg-pt__who">
              {if cell.solver, do: cell.solver.shown_as, else: GameCopy.payout_unclaimed()}
            </span>
          </li>
        </ol>
      </section>
      <div id="res-next" class="rg-next">
        <span :if={!@next} class="rg-next__t">{GameCopy.next_none()}</span>
        <span :if={@next && @next.play_status == "live"} class="rg-next__t">
          {GameCopy.next_lead()} <b :if={@next.number}>No. {@next.number}</b>
          <span :if={@next.number}>·</span> {@next.category.name} · {GameCopy.next_live_now()}
        </span>
        <span :if={@next && @next.play_status != "live"} class="rg-next__t">
          {GameCopy.next_lead()} <b>{@next.category.name}</b>
          · {GameCopy.next_drops_at()}
          <b><GameComponents.local_time
            id={"res-next-at-#{@next.id}-#{DateTime.to_unix(@next.live_date)}"}
            at={@next.live_date}
          /></b>
        </span>
        <.link
          :if={@next && @next.play_status == "ready"}
          navigate={~p"/game/#{@next.id}/lobby"}
          class="rg-btn rg-btn--hi rg-btn--wide"
        >
          {GameCopy.next_enter_lobby()} <GameComponents.icon name="arrow" />
        </.link>
        <.link
          :if={@next && @next.play_status == "live"}
          navigate={~p"/game/#{@next.id}/play"}
          class="rg-btn rg-btn--hi rg-btn--wide"
        >
          {GameCopy.next_jump_in()} <GameComponents.icon name="arrow" />
        </.link>
        <.link navigate={~p"/"} class="rg-link-btn">{GameCopy.next_home()}</.link>
      </div>
    </section>

    <section
      id="panel-chat"
      class="rg-results__chat is-off"
      role="tabpanel"
      aria-labelledby="tab-chat"
    >
      <h2 class="rg-panel__h rg-desk-only">Chat</h2>
      <ol
        id="chat-feed"
        class="rg-chat"
        phx-update="stream"
        aria-live="polite"
        aria-relevant="additions"
      >
        <%= for {dom_id, msg} <- @streams.answers do %>
          <li :if={divider?(msg)} id={dom_id} class="rg-chat__div" role="separator">
            {GameCopy.chat_divider()}
          </li>
          <li
            :if={not divider?(msg)}
            id={dom_id}
            class={[
              "rg-msg",
              msg.user_id == @current_user.id && "is-me",
              msg.chat && "is-chat",
              msg.correct && "is-solve",
              !msg.correct && !msg.chat && "is-wrong"
            ]}
          >
            <GameComponents.tile
              initial={GameComponents.initial(msg.username)}
              tone={GameComponents.tone(msg.username, @current_user.username)}
              size="sm"
            />
            <span class="rg-msg__body">
              <span class="rg-msg__name">
                {if msg.user_id == @current_user.id, do: GameCopy.room_you(), else: msg.username}
              </span>
              <span :if={msg.correct} class="rg-msg__stamp">
                <GameComponents.icon name="check" /> {GameCopy.feed_solved(msg.placement)}
              </span>
              <span class="rg-msg__text">{msg.text}</span>
            </span>
          </li>
        <% end %>
        <li :if={!@chat_open?} id="chat-empty" class="rg-chat__empty">
          {GameCopy.chat_archived()}
        </li>
      </ol>

      <form
        :if={@chat_open?}
        id="chat-form"
        class="rg-chat__bar"
        phx-submit="send_chat"
        phx-hook=".ChatForm"
      >
        <label class="rg-sr-only" for="chat-input">Message</label>
        <input
          id="chat-input"
          class="rg-chat__field"
          type="text"
          name="message"
          autocomplete="off"
          placeholder={GameCopy.chat_placeholder()}
        />
        <button class="rg-btn rg-btn--icon" type="submit" aria-label="Send message">
          <GameComponents.icon name="send" />
        </button>
      </form>
    </section>
  </div>
</Layouts.game>

<script :type={Phoenix.LiveView.ColocatedHook} name=".ChatForm">
  // Clears the field after a send. An empty send only puts focus back, since
  // a click on the send button takes it away.
  export default {
    mounted() {
      const input = this.el.querySelector("#chat-input")
      this.handleEvent("chat-sent", () => { input.value = "" })
      this.handleEvent("chat-empty", () => input.focus())
    }
  }
</script>

<script :type={Phoenix.LiveView.ColocatedHook} name=".ResultsTabs">
  // Runs the Leaderboard | Chat tabs below 1024px, counts chat that arrives
  // while Chat is hidden, and keeps the newest message in view.
  //
  // Panel classes and roles change through this.js() so that LiveView keeps
  // them across patches. At 1024px and up the tabs are hidden and both panels
  // show, so the panels drop their tabpanel roles.
  const NEAR_BOTTOM_PX = 80

  export default {
    mounted() {
      const $ = (sel) => this.el.querySelector(sel)
      this.tabs = { board: $("#tab-board"), chat: $("#tab-chat") }
      this.panels = { board: $("#panel-board"), chat: $("#panel-chat") }
      this.list = $("#chat-feed")
      this.badge = $("#chat-badge")
      this.tab = "board"
      this.unread = 0
      // Messages already on the page at mount never count as unread.
      this.seen = new Set([...this.list.querySelectorAll("li.rg-msg.is-chat")].map((li) => li.id))
      this.nearBottom = true

      this.tabs.board.addEventListener("click", () => this.setTab("board", false))
      this.tabs.chat.addEventListener("click", () => this.setTab("chat", false))
      $("#results-tabs").addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return
        e.preventDefault()
        this.setTab(this.tab === "board" ? "chat" : "board", true)
      })

      this.list.addEventListener("scroll", () => {
        const l = this.list
        this.nearBottom = l.scrollHeight - l.scrollTop - l.clientHeight < NEAR_BOTTOM_PX
      })
      this.toBottom()

      this.observer = new MutationObserver((records) => this.onAdded(records))
      this.observer.observe(this.list, { childList: true })

      this.desk = window.matchMedia("(min-width: 1024px)")
      this.onDeskChange = () => this.setRoles()
      this.desk.addEventListener("change", this.onDeskChange)
      this.setRoles()
    },

    destroyed() {
      this.observer.disconnect()
      this.desk.removeEventListener("change", this.onDeskChange)
    },

    setTab(tab, focus) {
      this.tab = tab
      const other = tab === "board" ? "chat" : "board"
      this.tabs[tab].setAttribute("aria-selected", "true")
      this.tabs[tab].tabIndex = 0
      this.tabs[other].setAttribute("aria-selected", "false")
      this.tabs[other].tabIndex = -1
      this.js().removeClass(this.panels[tab], "is-off")
      this.js().addClass(this.panels[other], "is-off")
      if (tab === "chat") {
        this.setUnread(0)
        // The panel shows on the next frame, so wait for it to have a height.
        requestAnimationFrame(() => this.toBottom())
      }
      if (focus) this.tabs[tab].focus()
    },

    // Counts each new chat message once. A reconnect re-sends the stream, and
    // the ids it has seen keep those rows from counting again. A player's own
    // message always scrolls into view, as it does in the design.
    onAdded(records) {
      let fresh = 0
      let mine = false
      for (const record of records) {
        for (const node of record.addedNodes) {
          if (!(node instanceof HTMLElement) || !node.matches("li.rg-msg.is-chat")) continue
          if (this.seen.has(node.id)) continue
          this.seen.add(node.id)
          fresh += 1
          if (node.classList.contains("is-me")) mine = true
        }
      }
      if (fresh === 0) return
      if (this.nearBottom || mine) this.toBottom()
      if (this.tab !== "chat" && !this.desk.matches) this.setUnread(this.unread + fresh)
    },

    setUnread(n) {
      this.unread = n
      this.badge.hidden = n === 0
      this.badge.textContent = String(n)
    },

    toBottom() {
      this.list.scrollTop = this.list.scrollHeight
      this.nearBottom = true
    },

    setRoles() {
      for (const key of ["board", "chat"]) {
        const panel = this.panels[key]
        if (this.desk.matches) {
          this.js().removeAttribute(panel, "role")
          this.js().removeAttribute(panel, "aria-labelledby")
        } else {
          this.js().setAttribute(panel, "role", "tabpanel")
          this.js().setAttribute(panel, "aria-labelledby", `tab-${key}`)
        }
      }
    }
  }
</script>
