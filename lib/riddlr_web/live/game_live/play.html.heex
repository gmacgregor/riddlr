<Layouts.game flash={@flash} current_scope={@current_scope} locked>
  <:status><GameComponents.status_pill kind={:play} number={@riddle.number} /></:status>
  <section class="rg-view rg-view--play" aria-labelledby="play-h">
    <div id="play-root" class={["rg-play", urgency(@time_remaining)]} phx-hook=".PlayFocus">
      <div class="rg-play__clock">
        <div class="rg-clockbar">
          <span class="rg-live-dot" aria-hidden="true"></span>
          <span class="rg-clockbar__label">Live</span>
          <span id="play-solved" class="rg-clockbar__solved rg-nowrap">{GameCopy.solved_count(
            MapSet.size(@solver_ids)
          )}</span>
          <time
            id="countdown-timer"
            class="rg-clockbar__time rg-nowrap"
            role="timer"
            aria-label="Time left"
            data-seconds={@time_remaining}
          >{GameCopy.m_ss(@time_remaining)}</time>
        </div>
        <div class="rg-clockbar__track" aria-hidden="true">
          <span
            id="play-fill"
            class="rg-clockbar__fill"
            style={"transform: scaleX(#{share_left(@time_remaining, @riddle.solve_time)})"}
          ></span>
        </div>
      </div>

      <div class="rg-play__riddle">
        <GameComponents.kicker number={@riddle.number} category={@riddle.category.name} />
        <h1 id="play-h" class="rg-riddle" tabindex="-1" aria-label={@riddle.description}>
          <%= for {word, i} <- Enum.with_index(@words) do %>
            <span
              class="rg-riddle__w"
              style={"--rg-delay: #{150 + i * 45}ms"}
              aria-hidden="true"
            >{word}</span>{" "}
          <% end %>
        </h1>
      </div>

      <section class="rg-play__feed" aria-labelledby="feed-h">
        <div class="rg-feed__head">
          <h2 id="feed-h" class="rg-panel__h">Guesses</h2>
          <span id="feed-count" class="rg-count rg-nowrap">{GameCopy.guess_count(@guess_count)}</span>
        </div>
        <ol
          id="answer-feed"
          class="rg-feed"
          phx-update="stream"
          phx-hook=".FeedScroll"
          aria-live="polite"
          aria-relevant="additions"
        >
          <li id="feed-empty" class="rg-feed__empty">{GameCopy.feed_empty()}</li>
          <li
            :for={{dom_id, answer} <- @streams.answers}
            id={dom_id}
            class={[
              "rg-msg",
              answer.user_id == @current_user.id && "is-me",
              if(answer.correct, do: "is-solve", else: "is-wrong")
            ]}
          >
            <GameComponents.tile
              initial={GameComponents.initial(answer.username)}
              tone={GameComponents.tone(answer.username, @current_user.username)}
              size="sm"
            />
            <span class="rg-msg__body">
              <span class="rg-msg__name">
                {if answer.user_id == @current_user.id,
                  do: GameCopy.room_you(),
                  else: answer.username}
              </span>
              <span :if={answer.correct} class="rg-msg__stamp">
                <GameComponents.icon name="check" /> {GameCopy.feed_solved(answer.placement)}
              </span>
              <span :if={not answer.correct} class="rg-msg__text">{answer.text}</span>
            </span>
            <span :if={answer.offset_ms} class="rg-msg__t">
              +{GameCopy.m_ss(div(answer.offset_ms, 1000))}
            </span>
          </li>
        </ol>
      </section>

      <div class="rg-play__input">
        <form
          :if={!@solve}
          id="answer-form"
          class="rg-guess"
          phx-submit="submit_answer"
          phx-hook=".GuessForm"
        >
          <label class="rg-guess__label" for="answer-input">Your answer</label>
          <div class="rg-guess__row">
            <input
              id="answer-input"
              class="rg-guess__field"
              type="text"
              name="answer"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              aria-describedby="guess-msg"
              aria-invalid={to_string(@guess_wrong?)}
            />
            <button
              id="guess-btn"
              class="rg-btn rg-btn--hi rg-guess__btn"
              type="submit"
              disabled={@cooling?}
            >
              {if @cooling?, do: "Wait", else: "Guess"}
            </button>
          </div>
          <p id="guess-msg" class={["rg-guess__msg", @guess_wrong? && "is-wrong"]} role="status">
            {@guess_msg}
          </p>
        </form>
        <div :if={@solve} id="solved-panel" class="rg-solved">
          <span id="solved-stamp" class={["rg-stamp", @solve.points == 0 && "is-none"]}>
            {String.upcase(GameCopy.ordinal(@solve.placement))}
          </span>
          <div class="rg-solved__text">
            <p class="rg-solved__title" role="status">
              {GameCopy.solved_title(@solve.placement, @solve.points)}
            </p>
            <p class="rg-solved__sub">{GameCopy.solved_sub(@solve.points, @time_remaining)}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layouts.game>

<script :type={Phoenix.LiveView.ColocatedHook} name=".PlayFocus">
  // On wide screens the guess input takes focus; on small ones the riddle
  // does, so the keyboard does not cover it.
  export default {
    mounted() {
      const input = this.el.querySelector("#answer-input")
      if (input && window.matchMedia("(min-width: 1024px)").matches) input.focus()
      else this.el.querySelector("#play-h")?.focus({ preventScroll: true })
    }
  }
</script>

<script :type={Phoenix.LiveView.ColocatedHook} name=".GuessForm">
  // On a wrong guess, shakes the row and selects the text so the next guess
  // types over it.
  export default {
    mounted() {
      this.handleEvent("guess-wrong", () => {
        const row = this.el.querySelector(".rg-guess__row")
        const input = this.el.querySelector("#answer-input")
        row.classList.remove("rg-shake")
        // Force a reflow so the browser restarts the shake animation.
        void row.offsetWidth
        row.classList.add("rg-shake")
        input.select()
      })
    }
  }
</script>

<script :type={Phoenix.LiveView.ColocatedHook} name=".FeedScroll">
  // Keeps the newest guess in view, unless the player has scrolled up to read.
  export default {
    mounted() {
      this.el.scrollTop = this.el.scrollHeight
    },
    beforeUpdate() {
      const el = this.el
      this.nearBottom = el.scrollHeight - el.scrollTop - el.clientHeight < 80
    },
    updated() {
      if (this.nearBottom) this.el.scrollTop = this.el.scrollHeight
    }
  }
</script>
