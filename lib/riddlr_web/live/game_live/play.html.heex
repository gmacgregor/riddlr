<Layouts.game flash={@flash} current_scope={@current_scope}>
  <%!-- ═══════════════════════════════════════════════════════════════
     TIMER + RIDDLE SECTION
     ═══════════════════════════════════════════════════════════════ --%>
  <section class="rg-timer-section" aria-label="Timer and riddle">
    <div class="rg-active-game" id="state-active">
      <%!-- <.game_time_remaining time_remaining={@time_remaining} /> --%>
      <div class="rg-time-bar">
        <span class="rg-time-bar__label">⏱ Time left</span>
        <time
          class="rg-time-bar__value leading-none"
          aria-live="polite"
          aria-atomic="true"
          id="countdown-timer"
          phx-hook=".SolveTimer"
          data-seconds={@time_remaining}
        >
          <span data-timer-display>{Feed.format_time(@time_remaining)}</span>
        </time>
      </div>
      <%!-- <.game_riddle_text riddle={@riddle} /> --%>
      <p
        id="riddle-description"
        class="rg-riddle-text"
        phx-hook=".RiddleReveal"
        data-text={@riddle.description}
      >
        {@riddle.description}
      </p>
    </div>
  </section>

  <%!-- ═══════════════════════════════════════════════════════════════
     CHAT SECTION — live game: answer feed + guess input
     ═══════════════════════════════════════════════════════════════ --%>
  <section class="rg-chat-section" aria-label="Live answers">
    <div class="rg-chat-header">
      <span class="rg-chat-header__label">💬 Live Answers</span>
      <span class="rg-chat-header__count" aria-live="polite">Live</span>
    </div>

    <%!-- Answer stream --%>
    <div
      id="answer-feed"
      phx-update="stream"
      class="rg-messages"
      aria-live="polite"
      aria-relevant="additions"
      aria-label="Answer feed"
    >
      <div
        :for={{dom_id, answer} <- @streams.answers}
        id={dom_id}
        class={["rg-msg", answer.correct && "rg-msg--solved"]}
      >
        <.rg_avatar
          letter={String.first(answer.username) |> String.upcase()}
          username={answer.username}
        />
        <span class="rg-msg__user">{answer.username}</span>
        <span :if={not answer.correct} class="rg-msg__text">{answer.text}</span>
        <.game_solve_badge
          :if={answer.correct}
          placement={answer.placement}
          class="rg-msg__text rg-msg__text--solved"
        />
        <span :if={answer.offset_ms} class="rg-msg__time">+{format_offset(answer.offset_ms)}</span>
      </div>
    </div>

    <%!-- Guess input — hidden once solved --%>
    <div
      :if={not @already_solved}
      id="answer-form-container"
      phx-hook=".AnswerForm"
      class="rg-input-bar"
    >
      <form id="answer-form" phx-submit="submit_answer" class="contents">
        <div class={[
          "rg-input-field",
          @submission_state == :incorrect && "rg-input-field--error"
        ]}>
          <input
            id="answer-input"
            type="text"
            name="answer"
            placeholder="Take a guess..."
            autocomplete="off"
            aria-label="Type your answer"
            aria-describedby={if @submission_state == :incorrect, do: "answer-feedback-incorrect"}
            aria-invalid={to_string(@submission_state == :incorrect)}
          />
        </div>
        <button class="rg-guess-btn" type="submit">Guess!</button>
      </form>
      <p
        :if={@submission_state == :incorrect}
        id="answer-feedback-incorrect"
        class="rg-answer-feedback"
        role="alert"
      >
        {@try_again_message}
      </p>
      <p
        :if={match?({:error, _}, @submission_state)}
        id="answer-feedback-error"
        class="rg-answer-feedback rg-answer-feedback--system"
        role="alert"
      >
        {elem(@submission_state, 1)}
      </p>
    </div>

    <%!-- Already solved banner --%>
    <div :if={@already_solved} class="rg-input-bar rg-input-bar--solved" role="status">
      <p class="rg-input-bar__solved-msg">
        {case @submission_state do
          {:correct, placement, points} -> "#{placement_text(placement)} place! +#{points} pts"
          _ -> "You already solved this one."
        end}
      </p>
    </div>
  </section>
</Layouts.game>

<%!-- ═══════════════════════════════════════════════════════════════
     JS HOOKS
     ═══════════════════════════════════════════════════════════════ --%>
<script :type={Phoenix.LiveView.ColocatedHook} name=".SolveTimer">
  export default {
    mounted() {
      this.displayEl = this.el.querySelector("[data-timer-display]")
      this.render(parseInt(this.el.dataset.seconds, 10) || 0)
      this.handleEvent("countdown-tick", ({ seconds }) => { this.render(seconds) })
    },
    render(secs) {
      const m = Math.floor(secs / 60).toString().padStart(2, "0")
      const s = (secs % 60).toString().padStart(2, "0")
      if (this.displayEl) this.displayEl.textContent = `${m}:${s}`
      const urgency = secs <= 10 ? "critical" : secs <= 30 ? "warning" : "normal"
      const card = this.el.closest("[id='solve-timer-card']") || this.el
      if (card.dataset.urgency !== urgency) card.dataset.urgency = urgency
    }
  }
</script>

<script :type={Phoenix.LiveView.ColocatedHook} name=".RiddleReveal">
  export default {
    mounted() {
      const para = this.el
      if (!para) return
      const escape = s => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
      const words = para.textContent.trim().split(/\s+/)
      para.innerHTML = words.map(w => `<span class="riddle-word">${escape(w)} </span>`).join("")
      setTimeout(() => {
        para.querySelectorAll(".riddle-word").forEach((span, i) => {
          setTimeout(() => span.classList.add("revealed"), i * 60)
        })
      }, 300)
    }
  }
</script>

<script :type={Phoenix.LiveView.ColocatedHook} name=".AnswerForm">
  export default {
    mounted() {
      this.handleEvent("answer-shake", () => {
        const input = this.el.querySelector("#answer-input")
        const field = this.el.querySelector(".rg-input-field")
        if (!input) return
        input.classList.remove("shake")
        void input.offsetWidth
        input.classList.add("shake")
        if (field) {
          field.classList.remove("rg-input-field--error-animate")
          void field.offsetWidth
          field.classList.add("rg-input-field--error-animate")
        }
        setTimeout(() => {
          input.classList.remove("shake")
          if (field) field.classList.remove("rg-input-field--error-animate")
        }, 700)
      })
      this.handleEvent("answer-correct", () => {
        this.el.style.transition = "opacity 400ms ease"
        this.el.style.opacity = "0"
        setTimeout(() => { this.el.style.display = "none" }, 400)
      })
    }
  }
</script>
