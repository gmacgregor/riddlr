<.header>
  {@page_title}
  <:actions>
    <.button :if={@live_action not in [:new]} patch={~p"/admin/riddles/new"} variant="primary">
      New Riddle
    </.button>
  </:actions>
</.header>

<div :if={@live_action in [:new, :edit]} class="adm-form-section">
  <.live_component
    module={RiddlrWeb.Admin.RiddleLive.FormComponent}
    id={@riddle.id || :new}
    action={@live_action}
    riddle={@riddle}
    current_user={@current_user}
    patch={~p"/admin/riddles"}
  />
</div>

<div :if={@live_action == :show && @riddle} class="adm-form-section">
  <.header>
    {@riddle.name}
    <:actions>
      <.button patch={~p"/admin/riddles/#{@riddle}/edit"}>Edit</.button>
      <.link patch={~p"/admin/riddles"} class="rg-link-btn">Back</.link>
    </:actions>
  </.header>
  <div class="mt-4 space-y-4">
    <div>
      <h4 class="font-semibold">Description</h4>
      <p>{@riddle.description}</p>
    </div>
    <div>
      <h4 class="font-semibold">Play status</h4>
      <p>{play_status_text(@riddle.play_status)}</p>
    </div>
    <div>
      <h4 class="font-semibold">Category</h4>
      <p>{@riddle.category.name}</p>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <h4 class="font-semibold">Difficulty</h4>
        <p>{@riddle.difficulty}</p>
      </div>
      <div>
        <h4 class="font-semibold">Solve Time</h4>
        <p>{@riddle.solve_time} seconds</p>
      </div>
    </div>
    <div>
      <h4 class="font-semibold">Answers</h4>
      <ul class="adm-list">
        <%= for answer <- @riddle.answers do %>
          <li>{answer}</li>
        <% end %>
      </ul>
    </div>
    <div :if={@riddle.hint}>
      <h4 class="font-semibold">Hint</h4>
      <p>{@riddle.hint}</p>
      <p class="adm-note">Available after {@riddle.hint_delay} seconds</p>
    </div>
  </div>
</div>

<.table
  :if={@live_action not in [:new, :edit]}
  id="riddles"
  rows={@streams.riddles}
  row_click={fn {_id, riddle} -> JS.patch(~p"/admin/riddles/#{riddle}") end}
>
  <:col :let={{_id, riddle}} label="No.">{riddle.number}</:col>
  <:col :let={{_id, riddle}} label="Name">
    <.link navigate={~p"/game/#{riddle}/lobby"} class="adm-link">
      {riddle.name}
    </.link>
  </:col>
  <:col :let={{_id, riddle}} label="Difficulty">{riddle.difficulty}</:col>
  <:col :let={{_id, riddle}} label="Category">{riddle.category.name}</:col>
  <:col :let={{_id, riddle}} label="Status">{riddle.publish_status}</:col>
  <:col :let={{_id, riddle}} label="Play Status">
    <span class={["adm-badge", play_status_color(riddle.play_status)]}>
      {play_status_text(riddle.play_status)}
    </span>
  </:col>
  <:col :let={{_id, riddle}} label="Live Date">{format_live_date(riddle.live_date)}</:col>
  <:action :let={{_id, riddle}}>
    <.link patch={~p"/admin/riddles/#{riddle}/edit"}>Edit</.link>
  </:action>
  <:action :let={{_id, riddle}}>
    <.link
      phx-click={JS.push("delete", value: %{id: riddle.id}) |> hide("#riddles-#{riddle.id}")}
      data-confirm="Are you sure?"
    >
      Delete
    </.link>
  </:action>
</.table>
