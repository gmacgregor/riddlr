<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.auth_shell title={"Welcome #{@user.username}"}>
    <:subtitle :if={!@user.confirmed_at}>
      Confirm your account to finish signing up.
    </:subtitle>

    <.form
      :if={!@user.confirmed_at}
      for={@form}
      id="confirmation_form"
      action={~p"/users/log-in?_action=confirmed"}
      phx-mounted={JS.focus_first()}
      class="rg-auth__form"
    >
      <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
      <.auth_submit
        name={@form[:remember_me].name}
        value="true"
        phx-disable-with="Confirming..."
      >
        Confirm and stay logged in
      </.auth_submit>
      <.auth_ghost_button phx-disable-with="Confirming...">
        Confirm and log in only this time
      </.auth_ghost_button>
    </.form>

    <.form
      :if={@user.confirmed_at}
      for={@form}
      id="login_form"
      action={~p"/users/log-in"}
      phx-mounted={JS.focus_first()}
      class="rg-auth__form"
    >
      <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
      <%= if @current_scope do %>
        <.auth_submit phx-disable-with="Logging in...">Log in</.auth_submit>
      <% else %>
        <.auth_submit
          name={@form[:remember_me].name}
          value="true"
          phx-disable-with="Logging in..."
        >
          Keep me logged in on this device
        </.auth_submit>
        <.auth_ghost_button phx-disable-with="Logging in...">
          Log me in only this time
        </.auth_ghost_button>
      <% end %>
    </.form>
  </.auth_shell>
</Layouts.app>
