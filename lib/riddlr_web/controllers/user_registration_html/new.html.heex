<Layouts.game flash={@flash} current_scope={@current_scope} theme={@theme}>
  <.auth_shell title="Create your account">
    <:subtitle>Pick a name, add your email, and start solving.</:subtitle>

    <.form :let={f} for={@changeset} action={~p"/users/register"} class="rg-auth__form">
      <.input field={f[:username]} label="Username" placeholder="riddlemaster" required />
      <.input
        field={f[:email]}
        type="email"
        label="Email"
        autocomplete="username"
        spellcheck="false"
        placeholder="you@example.com"
        required
        phx-mounted={JS.focus()}
      />
      <.notify_me_group form={f} text={@sms_enabled?} text_field={:text_requested}>
        <:text_steps :if={@sms_enabled?}>
          <%!-- Not `required`: the field hides while Text is off. The
               changeset needs it when Text is ticked. --%>
          <div class="rg-notify__phone" data-needs-text>
            <.phone_field field={f[:signup_phone]} required={false} />
            <.text_consent />
            <p class="rg-phone__note">
              We text you a code when you first log in. Texts start once you enter it.
            </p>
          </div>
        </:text_steps>
      </.notify_me_group>
      <.auth_submit phx-disable-with="Creating account...">
        Create an account <span aria-hidden="true">→</span>
      </.auth_submit>
    </.form>

    <p class="rg-auth__footer">
      Already registered? <.link navigate={~p"/users/log-in"} class="rg-auth__link">Log in</.link>
    </p>
  </.auth_shell>
</Layouts.game>
