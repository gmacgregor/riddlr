<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.auth_shell title="Create your account">
    <:subtitle>Pick a name, add your email, and start solving.</:subtitle>

    <.form :let={f} for={@changeset} action={~p"/users/register"} class="rg-auth__form">
      <.auth_input field={f[:username]} label="Username" placeholder="riddlemaster" required />
      <.auth_input
        field={f[:email]}
        type="email"
        label="Email"
        autocomplete="username"
        spellcheck="false"
        placeholder="you@example.com"
        required
        phx-mounted={JS.focus()}
      />
      <.auth_submit phx-disable-with="Creating account...">
        Create an account <span aria-hidden="true">→</span>
      </.auth_submit>
    </.form>

    <p class="rg-auth__footer">
      Already registered? <.link navigate={~p"/users/log-in"} class="rg-auth__link">Log in</.link>
    </p>
  </.auth_shell>
</Layouts.app>
