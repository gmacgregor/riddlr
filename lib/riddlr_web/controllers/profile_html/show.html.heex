<Layouts.game flash={@flash} current_scope={@current_scope} theme={@theme}>
  <.auth_shell title="Profile">
    <:subtitle>Your account at a glance.</:subtitle>

    <dl class="rg-auth__meta">
      <div class="rg-auth__meta-row">
        <dt class="rg-auth__meta-label">Username</dt>
        <dd id="profile-username" class="rg-auth__meta-value">{@current_scope.user.username}</dd>
      </div>
      <div class="rg-auth__meta-row">
        <dt class="rg-auth__meta-label">Email</dt>
        <dd id="profile-email" class="rg-auth__meta-value">{@current_scope.user.email}</dd>
      </div>
      <div class="rg-auth__meta-row">
        <dt class="rg-auth__meta-label">Notifications</dt>
        <dd id="profile-notifications" class="rg-auth__meta-value">
          {notification_summary(@current_scope.user)}
        </dd>
      </div>
    </dl>

    <.form
      :let={f}
      for={@email_changeset}
      action={~p"/profile"}
      id="update_email"
      class="rg-auth__form"
    >
      <input type="hidden" name="action" value="update_email" />

      <.input
        field={f[:email]}
        type="email"
        label="Change email"
        autocomplete="username"
        spellcheck="false"
        required
      />

      <.auth_submit phx-disable-with="Changing...">Change email</.auth_submit>
    </.form>

    <.form
      :let={f}
      for={@notifications_changeset}
      action={~p"/profile"}
      id="update_notifications"
      class="rg-auth__form"
    >
      <input type="hidden" name="action" value="update_notifications" />

      <.notify_me_group form={f} text={@sms_enabled?}>
        <:text_steps :if={@sms_enabled?}>
          <%!-- The phone steps sit under the Text box, but forms cannot nest:
               their fields join the empty forms below through form="…". --%>
          <div
            :if={@current_scope.user.phone_confirmed_at}
            id="phone-confirmed"
            class="rg-notify__phone"
          >
            <p class="rg-phone__confirmed">
              {Riddlr.SMS.mask(@current_scope.user.phone)} <span>Confirmed</span>
            </p>
            <p class="rg-phone__links">
              <.link href={~p"/profile?phone=new"} class="rg-auth__link">Change number</.link>
              <button
                type="submit"
                form="remove_phone"
                class="rg-auth__link rg-phone__link-btn"
                data-confirm="Remove your number? We delete it from your account."
              >
                Remove number
              </button>
            </p>
            <p class="rg-phone__note">
              Unchecking Text pauses texts and keeps your number. Remove number deletes it.
            </p>
          </div>

          <div
            :if={@phone_step == :enter}
            class="rg-notify__phone"
            data-needs-text={@phone_gated?}
          >
            <.phone_field field={@phone_form[:phone]} form="send_phone_code" />
            <.text_consent />
            <.auth_submit form="send_phone_code" phx-disable-with="Sending...">
              Text me a code
            </.auth_submit>
          </div>

          <div :if={@phone_step == :code} class="rg-notify__phone">
            <p class="rg-phone__note">
              We texted a 6-digit code to {@pending_phone}. It works for {Riddlr.Accounts.phone_code_ttl_minutes()} minutes.
            </p>
            <.input
              field={@code_form[:code]}
              form="confirm_phone"
              type="text"
              label="Code"
              inputmode="numeric"
              autocomplete="one-time-code"
              maxlength="6"
              placeholder="123456"
              required
            />
            <.auth_submit form="confirm_phone" phx-disable-with="Checking...">
              Confirm number
            </.auth_submit>
            <p class="rg-phone__links">
              <button
                type="submit"
                form="resend_phone_code"
                class="rg-auth__link rg-phone__link-btn"
              >
                Send a new code
              </button>
              <.link href={~p"/profile?phone=new"} class="rg-auth__link">Use another number</.link>
            </p>
          </div>
        </:text_steps>
      </.notify_me_group>

      <.input
        field={f[:notification_lead_time]}
        type="select"
        label="When"
        options={[
          {"When the Lobby opens", :lobby_open},
          {"30 min before", :min_30},
          {"1 hour before", :min_60}
        ]}
      />

      <.auth_submit phx-disable-with="Saving...">Save notifications</.auth_submit>
    </.form>

    <%!-- Empty phone step forms. Their fields live in the Notify me group. --%>
    <.phone_step_form
      :if={@sms_enabled? && @current_scope.user.phone_confirmed_at}
      id="remove_phone"
    />
    <.phone_step_form :if={@sms_enabled? && @phone_step == :enter} id="send_phone_code" />
    <.phone_step_form :if={@sms_enabled? && @phone_step == :code} id="confirm_phone" />
    <.phone_step_form :if={@sms_enabled? && @phone_step == :code} id="resend_phone_code" />

    <p class="rg-auth__footer">
      <.link navigate={~p"/"} class="rg-auth__link">Back to the game</.link>
    </p>
  </.auth_shell>
</Layouts.game>
