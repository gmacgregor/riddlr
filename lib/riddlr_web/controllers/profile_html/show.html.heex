<Layouts.game flash={@flash} current_scope={@current_scope} theme={@theme}>
  <.auth_shell title="Profile">
    <:subtitle>Your account at a glance.</:subtitle>

    <dl class="rg-auth__meta">
      <div class="rg-auth__meta-row">
        <dt class="rg-auth__meta-label">Username</dt>
        <dd id="profile-username" class="rg-auth__meta-value">{@current_scope.user.username}</dd>
      </div>
      <div class="rg-auth__meta-row">
        <dt class="rg-auth__meta-label">Email</dt>
        <dd id="profile-email" class="rg-auth__meta-value">{@current_scope.user.email}</dd>
      </div>
      <div class="rg-auth__meta-row">
        <dt class="rg-auth__meta-label">Notifications</dt>
        <dd id="profile-notifications" class="rg-auth__meta-value">
          <%= if RiddlrWeb.PrototypeSmsOptIn.enabled?() do %>
            {RiddlrWeb.PrototypeSmsOptIn.summary(RiddlrWeb.PrototypeSmsOptIn.state(@conn.params))}
          <% else %>
            {notification_summary(@current_scope.user)}
          <% end %>
        </dd>
      </div>
    </dl>

    <.form
      :let={f}
      for={@email_changeset}
      action={~p"/profile"}
      id="update_email"
      class="rg-auth__form"
    >
      <input type="hidden" name="action" value="update_email" />

      <.input
        field={f[:email]}
        type="email"
        label="Change email"
        autocomplete="username"
        spellcheck="false"
        required
      />

      <.auth_submit phx-disable-with="Changing...">Change email</.auth_submit>
    </.form>

    <RiddlrWeb.PrototypeSmsOptIn.profile_section
      :if={RiddlrWeb.PrototypeSmsOptIn.enabled?()}
      state={RiddlrWeb.PrototypeSmsOptIn.state(@conn.params)}
    />

    <.form
      :if={!RiddlrWeb.PrototypeSmsOptIn.enabled?()}
      :let={f}
      for={@notifications_changeset}
      action={~p"/profile"}
      id="update_notifications"
      class="rg-auth__form"
    >
      <input type="hidden" name="action" value="update_notifications" />

      <.input field={f[:notify_email]} type="checkbox" label="Email me before riddles go live" />

      <.input
        field={f[:notification_lead_time]}
        type="select"
        label="When"
        options={[
          {"When the Lobby opens", :lobby_open},
          {"30 min before", :min_30},
          {"1 hour before", :min_60}
        ]}
      />

      <.auth_submit phx-disable-with="Saving...">Save notifications</.auth_submit>
    </.form>

    <p class="rg-auth__footer">
      <.link navigate={~p"/"} class="rg-auth__link">Back to the game</.link>
    </p>
  </.auth_shell>
  <RiddlrWeb.PrototypeSmsOptIn.switcher
    :if={RiddlrWeb.PrototypeSmsOptIn.enabled?()}
    state={RiddlrWeb.PrototypeSmsOptIn.state(@conn.params)}
  />
</Layouts.game>
