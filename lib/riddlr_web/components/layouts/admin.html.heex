<div class="adm-page">
  <header class="adm-header">
    <div class="adm-header__inner">
      <.link navigate={~p"/"} class="adm-header__brand">Riddlr</.link>
      <span class="adm-header__badge">Admin</span>
    </div>
    <nav class="adm-header__nav">
      <.link navigate={~p"/admin/riddles"} class="adm-header__link">Riddles</.link>
      <.link navigate={~p"/admin/categories"} class="adm-header__link">Categories</.link>
      <.link navigate={~p"/"} class="adm-header__link">Back to Site</.link>
      <.auth_menu current_scope={@current_scope} />
    </nav>
  </header>
  <main class={["adm-main", "adm-main-#{@live_action}"]}>
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>
</div>
