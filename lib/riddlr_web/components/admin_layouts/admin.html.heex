<div class="rg-app adm-page">
  <.topbar current_scope={@current_scope} theme={@theme}>
    <nav class="adm-nav" aria-label="Admin">
      <span class="adm-nav__badge">Admin</span>
      <.link
        navigate={~p"/admin/riddles"}
        class="adm-nav__link"
        aria-current={admin_nav_current(@current_path, ~p"/admin/riddles")}
      >
        Riddles
      </.link>
      <.link
        navigate={~p"/admin/categories"}
        class="adm-nav__link"
        aria-current={admin_nav_current(@current_path, ~p"/admin/categories")}
      >
        Categories
      </.link>
      <.link
        :if={Riddlr.Authorization.has_permission?(@current_user, :manage_riddles)}
        navigate={~p"/admin/practice-riddles"}
        class="adm-nav__link"
        aria-current={admin_nav_current(@current_path, ~p"/admin/practice-riddles")}
      >
        Practice riddles
      </.link>
      <.link navigate={~p"/"} class="adm-nav__link">Site</.link>
    </nav>
  </.topbar>

  <main class="rg-main">
    <div class={["adm-main", "adm-main-#{@live_action}"]}>
      {@inner_content}
    </div>
  </main>

  <.flash_group flash={@flash} />
</div>
